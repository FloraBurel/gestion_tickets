{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <div>
        {{ message }}
    </div>
{% endfor %}

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Catégories</h1>
            <a href="{{ path('app_categorie_add') }}" class="btn btn-primary">+ Nouvelle catégorie</a>
        </div>

        <div class="bg-white rounded-4 shadow-sm p-4">
            <table class="table table-hover align-middle">
                    <thead><tr><th>Nom</th><th class="text-end"></th></tr></thead>
                    <tbody>
                    {% for categorie in categories %}<tr><td>{{ categorie.nom }}</td><td class="text-end"><a href="{{ path('app_categorie_edit', {'id': categorie.id}) }}">Modifier</a></td></tr>
                    {% endfor %}
                    </tbody>
            </table>
        </div>
    </div>
    
{% endblock %}

