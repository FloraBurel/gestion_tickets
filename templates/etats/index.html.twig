{% extends 'base.html.twig' %}

{% block title %}Liste des états{% endblock %}

{% block body %}

    {% for message in app.flashes('success') %}
        <div>
            {{ message }}
        </div>
    {% endfor %}


<div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">États</h1>

            <a href="{{ path('app_etat_add') }}" class="btn btn-primary">
                + Nouvel état
            </a>
       </div>

        <div class="bg-white rounded-4 shadow-sm p-4">
            <table class="table table-hover align-middle">
                    <thead><tr><th>Nom</th><th class="text-end"></th></tr></thead>
                <tbody>
                    {% for etat in etats %}
                        <tr><td>{{ etat.nom }}</td><td class="text-end">
                            {% if etat.nom != 'Nouveau' and etat.nom != 'Fermé' %}
                            <a href="{{ path('app_etat_edit', {'id': etat.id}) }}">Modifier</a>
                            {% endif %}
                        </td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
</div>
{% endblock %}

