{% extends 'base.html.twig' %}

{% block title %}Liste des responsables{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <div>
        {{ message }}
    </div>
{% endfor %}


<div class="container py-5">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Responsables</h1>

    <a href="{{ path('app_responsable_add') }}" class="btn btn-primary">
        + Nouveau responsable
    </a>
    </div>

<div class="bg-white rounded-4 shadow-sm p-4">
<table class="table table-hover align-middle">
<thead><tr><th>Nom</th><th>Email</th><th class="text-end"></th></tr></thead>
<tbody>{% for responsable in responsables %}<tr><td>{{ responsable.nom }}</td><td>{{ responsable.email }}</td><td class="text-end"><a href="{{ path('app_responsable_edit', {'id': responsable.id}) }}">Modifier</a></td></tr>
{% endfor %}</tbody>
</table>
</div>
</div>
   

{% endblock %}

