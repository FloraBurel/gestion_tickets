{% extends 'base.html.twig' %}

{% block title %}Liste des responsables{% endblock %}

{% block body %}

{% for message in app.flashes('success') %}
    <div>
        {{ message }}
    </div>
{% endfor %}

<h1>Liste des responsables</h1>
<table>
<thead><tr><th>Nom</th><th>Email</th></tr></thead>
<tbody>{% for responsable in responsables %}<tr><td>{{ responsable.nom }}</td><td>{{ responsable.email }}</td><td><a href="{{ path('app_responsable_edit', {'id': responsable.id}) }}">Modifier</a></td></tr>
{% endfor %}</tbody>
</table>
<a href="{{ path('app_responsable_add') }}">Ajouter</a>
{% endblock %}

