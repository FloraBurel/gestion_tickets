{% extends 'base.html.twig' %}


{% block title %}Liste des tickets{% endblock %} 


 
{% block body %}

{% for message in app.flashes('success') %}
    <div>
        {{ message }}
    </div>
{% endfor %}


    <h1>Liste des tickets</h1>

    <table>
    <thead><tr><th>ID</th><th>Auteur</th><th>Description</th><th>Date d'ouverture</th><th>Date de cloture</th><th>Catégorie</th><th>État</th><th>Responsable</th></tr></thead>
    
    <tbody>
    {% for ticket in tickets %}

    <tr><td>{{ ticket.id }}</td>
    <td>{{ ticket.auteur }}</td>
    <td>{{ ticket.description }}</td>
    <td>{{ ticket.dateOuverture|date('d/m/Y') }}</td>
    <td>{% if ticket.dateCloture %}
    {{ ticket.dateCloture|date('d/m/Y') }}
    {% else %}
        Non clôturé
    {% endif %}</td>
    <td>{{ ticket.categorie.nom }}</td>
    <td>{{ ticket.etat.nom }}</td>
    <td>{% if ticket.responsable %}
    {{ ticket.responsable.email }}
    {% else %}
        Non attribué
    {% endif %} </td>
    <td><a href="{{ path('app_ticket_edit', {'id': ticket.id}) }}">Modifier</a></td></tr>

    {% endfor %}
    </tbody>
    </table>
   
{% endblock %}
